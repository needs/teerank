generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterServer {
  id               Int          @id @default(autoincrement())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  polledAt         DateTime?
  pollingStartedAt DateTime?
  address          String
  port             Int
  gameServers      GameServer[]

  @@unique([address, port])
}

model GameServer {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  playTime   BigInt   @default(0)

  polledAt         DateTime?
  pollingStartedAt DateTime?
  pollBatchUuid    String?   @db.Uuid()

  ip   String
  port Int

  masterServer   MasterServer? @relation(fields: [masterServerId], references: [id])
  masterServerId Int?

  snapshots       GameServerSnapshot[] @relation(name: "GameServerSnapshotGameServerId")
  gameServerState GameServerState?     @relation(name: "GameServerStateGameServerId")

  @@unique([ip, port])
  @@index([polledAt])
  @@index([updatedAt])
  @@index([createdAt])
}

model GameServerState {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version String
  name    String

  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
  mapId Int

  numPlayers Int
  maxPlayers Int

  numClients Int
  maxClients Int

  clients GameServerStateClient[]

  gameServer   GameServer @relation(name: "GameServerStateGameServerId", fields: [gameServerId], references: [id], onDelete: Cascade)
  gameServerId Int        @unique
}

model GameServerStateClient {
  id Int @id @default(autoincrement())

  gameServerState   GameServerState @relation(fields: [gameServerStateId], references: [id], onDelete: Cascade)
  gameServerStateId Int

  player     Player @relation(fields: [playerName], references: [name], onDelete: Cascade)
  playerName String

  clan     Clan?   @relation(fields: [clanName], references: [name], onDelete: Cascade)
  clanName String?

  score   Int
  country Int
  inGame  Boolean

  @@index([gameServerStateId])
  @@index([score, inGame])
  @@index([playerName])
}

model Player {
  name       String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  clan                  Clan?    @relation(fields: [clanName], references: [name])
  clanName              String?
  clanSnapshotCreatedAt DateTime @default(now())

  playTime BigInt @default(0)

  gameServerClients      GameServerClient[]
  gameServerStateClients GameServerStateClient[]
  clanPlayerInfos        ClanPlayerInfo[]

  playerInfoMaps      PlayerInfoMap[]
  playerInfoGameTypes PlayerInfoGameType[]

  @@index([playTime(sort: Desc)])
  @@index([updatedAt])
}

enum RankMethod {
  ELO
  TIME
}

model GameType {
  name       String      @id
  createdAt  DateTime    @default(now())
  map        Map[]
  rankMethod RankMethod?
  playTime   BigInt      @default(0)

  playerCount     Int @default(0)
  clanCount       Int @default(0)
  gameServerCount Int @default(0)
  mapCount        Int @default(0)

  playerInfoGameTypes PlayerInfoGameType[]
  clanInfoGameTypes   ClanInfoGameType[]

  @@index([createdAt])
}

model Map {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  playTime  BigInt   @default(0)

  gameType     GameType @relation(fields: [gameTypeName], references: [name], onDelete: Cascade)
  gameTypeName String

  playerCount     Int @default(0)
  clanCount       Int @default(0)
  gameServerCount Int @default(0)

  countedAt DateTime @default(now())

  snapshots        GameServerSnapshot[]
  playerInfoMaps   PlayerInfoMap[]
  clanInfoMaps     ClanInfoMap[]
  gameServerStates GameServerState[]

  @@unique([name, gameTypeName])
  @@index([countedAt])
}

model PlayerInfoGameType {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player     Player @relation(fields: [playerName], references: [name], onDelete: Cascade)
  playerName String

  rating   Float?
  playTime BigInt @default(0)

  gameType     GameType @relation(fields: [gameTypeName], references: [name], onDelete: Cascade)
  gameTypeName String

  @@unique([playerName, gameTypeName])
}

model PlayerInfoMap {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player     Player @relation(fields: [playerName], references: [name], onDelete: Cascade)
  playerName String

  rating   Float?
  playTime BigInt @default(0)

  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
  mapId Int

  @@unique([playerName, mapId])
  @@index([playTime(sort: Desc)])
  @@index([rating])
}

model GameServerClient {
  id Int @id @default(autoincrement())

  snapshot   GameServerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId Int

  player     Player @relation(fields: [playerName], references: [name], onDelete: Cascade)
  playerName String

  clan     Clan?   @relation(fields: [clanName], references: [name], onDelete: Cascade)
  clanName String?

  score   Int
  country Int
  inGame  Boolean

  @@index([snapshotId])
  @@index([score, inGame])
  @@index([playerName])
}

model GameServerSnapshot {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  version String
  name    String
  map     Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  mapId   Int

  numPlayers Int
  maxPlayers Int

  numClients Int
  maxClients Int

  clients GameServerClient[]

  gameServerId Int
  gameServer   GameServer @relation(name: "GameServerSnapshotGameServerId", fields: [gameServerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([version])
}

model ClanInfoGameType {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan     Clan   @relation(fields: [clanName], references: [name], onDelete: Cascade)
  clanName String

  playTime BigInt @default(0)

  gameType     GameType @relation(fields: [gameTypeName], references: [name], onDelete: Cascade)
  gameTypeName String

  @@unique([clanName, gameTypeName])
}

model ClanInfoMap {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan     Clan   @relation(fields: [clanName], references: [name], onDelete: Cascade)
  clanName String

  playTime BigInt @default(0)

  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
  mapId Int

  @@unique([clanName, mapId])
  @@index([playTime(sort: Desc)])
}

model Clan {
  name String @id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playTime BigInt   @default(0)
  players  Player[]

  clients GameServerClient[]

  clanPlayerInfos ClanPlayerInfo[]

  clanInfoGameTypes      ClanInfoGameType[]
  clanInfoMaps           ClanInfoMap[]
  gameServerStateClients GameServerStateClient[]

  @@index([playTime(sort: Desc)])
  @@index([updatedAt])
}

model ClanPlayerInfo {
  clan     Clan   @relation(fields: [clanName], references: [name], onDelete: Cascade)
  clanName String

  player     Player @relation(fields: [playerName], references: [name], onDelete: Cascade)
  playerName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playTime BigInt @default(0)

  @@unique([clanName, playerName])
  @@index([playTime(sort: Desc)])
}

model GlobalCounts {
  globalId  String   @id
  updatedAt DateTime @updatedAt

  playerCount     Int @default(0)
  clanCount       Int @default(0)
  gameServerCount Int @default(0)
}
